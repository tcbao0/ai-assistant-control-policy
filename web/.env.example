# Network
SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_NETWORK=testnet
# Optional gRPC endpoint override; defaults to public fullnode for SUI_NETWORK
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Agent signer (suiprivkey... bech32 OR 0x-hex / bare hex of 32-byte secret)
AGENT_PRIVATE_KEY=

# Deployed Move package. Each owner's vault, policy, admin caps and transfer grant IDs
# are registered to their wallet in MongoDB after signed setup transactions.
PACKAGE_ID=
# Latest upgraded package ID for Move calls and new events. Defaults to PACKAGE_ID.
# PACKAGE_PUBLISHED_AT=
# Shared Clock object (Sui system object)
CLOCK_ID=0x6

# Client-visible IDs for owner wallet administration
NEXT_PUBLIC_PACKAGE_ID=
# NEXT_PUBLIC_PACKAGE_PUBLISHED_AT=
NEXT_PUBLIC_AGENT_ADDRESS=
NEXT_PUBLIC_CLOCK_ID=0x6
# NEXT_PUBLIC_EXPLORER_BASE=https://suiscan.xyz/testnet/tx

# Optional: Move target override (defaults to PACKAGE_ID::payment::execute_payment_or_abort)
# PAYMENT_TARGET=0xPACKAGE::payment::execute_payment_or_abort

# Gemini (free tier) — required for bill extraction at /api/chat/bill
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=subscription_manager
SCHEDULER_SECRET=
# Optional preferred model (defaults try free Flash models in order)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Temporary recovery values for revoking the previously deployed policy, if needed.
NEXT_PUBLIC_LEGACY_PACKAGE_ID=
NEXT_PUBLIC_LEGACY_POLICY_ID=
NEXT_PUBLIC_LEGACY_ADMIN_CAP_ID=
NEXT_PUBLIC_LEGACY_OWNER_ADDRESS=
